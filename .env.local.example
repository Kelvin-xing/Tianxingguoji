# Synthetic local development only. Never reuse these values outside this machine.
APP_ENV=development
NODE_ENV=development
APP_RUNTIME_MODE=local-synthetic
AUTH_MODE=database-test

# Founder-invite internal email mode (select this instead of database-test when testing it):
# AUTH_MODE=internal-email
# APP_BASE_URL=http://localhost:3000
# EMAIL_FROM=no-reply@example.test.invalid
# EMAIL_TRANSPORT=deterministic-fake
# Database-backed Resend: EMAIL_TRANSPORT=resend. Admin stores the Resend key and sender in the application.
# Generate a 32-byte base64url master key; never commit the real value.
# EMAIL_SETTINGS_MASTER_KEY=replace-with-32-byte-base64url-value
# EMAIL_SETTINGS_MASTER_KEY_VERSION=v1

LOCAL_SYNTHETIC_POSTGRES_PASSWORD=not-a-secret
LOCAL_SYNTHETIC_DATABASE_URL=postgresql://tianxing_app:not-a-secret@127.0.0.1:5432/tianxing
LOCAL_SYNTHETIC_DEPENDENCY_TIMEOUT_MS=2000
LOCAL_SYNTHETIC_ORGANIZATION_ID=51000000-0000-4000-8000-000000000001

# Explicit non-production transport. It is process-local and deterministic.
DOCUMENT_TRANSPORT_MODE=deterministic-fake
DOCUMENT_FAKE_REGION=ap-east-1
DOCUMENT_FAKE_BUCKET=tianxing-local-documents
DOCUMENT_FAKE_ORIGIN=http://localhost:3000
DOCUMENT_FAKE_SIGNING_SECRET=local-only-replace-with-32-plus-characters
DOCUMENT_FAKE_ORGANIZATION_ID=51000000-0000-4000-8000-000000000001
DOCUMENT_FAKE_WORKER_CONTEXT_ID=10000000-0000-4000-8000-000000000901
